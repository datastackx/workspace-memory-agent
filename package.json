{
  "name": "workspace-memory-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A small Claude tool-calling agent with persistent, workspace-scoped memory in Postgres.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "agent": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
